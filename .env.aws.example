# AWS 단일 EC2 배포본(docker-compose.aws.yml) 환경변수 템플릿 — 값은 비워둔다(평문 커밋 금지).
# 사용법: 이 파일을 복사해 .env.aws 로 채운다(.env.aws 는 .gitignore 로 커밋되지 않는다).
#   docker compose -f docker-compose.yml -f docker-compose.aws.yml up -d
#
# 호스트명은 전부 compose 서비스명이다. 앱은 gateway(8080) 외에는 외부로 노출되지 않는다.

# ===== 공통 (전 서비스) =====
#
# ⚠️ 보안 경고 — prod,dev 조합
#    dev 프로파일은 DevToken 발급 엔드포인트 POST /api/v1/dev/auth/token 을 인증 없이 연다
#    (DevTokenController 는 @Profile({"local","dev"})). 부하 테스트 write 시나리오에 필요하다.
#    EC2 보안 그룹에서 본인 공인 IP /32 만 8080 을 허용하는 것은 선택이 아니라 필수 전제다.
#    Prometheus(9090)의 --web.enable-remote-write-receiver 도 인증이 없어 같은 제한이 적용된다.
#
#    application-dev.yml 은 존재하지 않는다. prod 로 접속 정보를 환경변수 주입받고
#    dev 는 DevToken 빈만 추가 등록하는 용도다. dev 단독으로 띄우면 datasource 가
#    base 의 localhost 기본값으로 떨어져 컨테이너 안에서 부팅에 실패한다.
SPRING_PROFILES_ACTIVE=prod,dev

# DB — 앱이 읽는 키. url = jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ticket_rush
MYSQL_USERNAME=ticketrush
MYSQL_PASSWORD=

# MySQL 컨테이너 초기화용. mysql 이미지가 읽는 키 이름이 앱과 달라 중복이 생긴다.
#   MYSQL_DATABASE ≡ DB_NAME,  MYSQL_USER ≡ MYSQL_USERNAME,  MYSQL_PASSWORD 는 공유.
# MYSQL_USER 는 root 가 될 수 없다(mysql 이미지 제약).
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ticket_rush
MYSQL_USER=ticketrush

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
REDIS_HOST=redis
REDIS_PORT=6379

# 게이트웨이 내부 호출 토큰(전 서비스 공유, 반드시 오버라이드)
GATEWAY_INTERNAL_TOKEN=
# Swagger 노출 서버 URL — EC2 공인 IP 는 중지·시작 때마다 바뀐다(Elastic IP 미사용)
SWAGGER_SERVER_URL=http://<EC2_PUBLIC_IP>:8080

# 서비스 간 직접 호출 base URL (base yml 의 localhost 기본값 오버라이드)
# 아래 gateway 의 *_SERVICE_HOST 와는 다른 키다. 둘 다 필요하다.
AUTH_SERVICE_URL=http://auth-service:8082
USER_SERVICE_URL=http://user-service:8081
SEAT_SERVICE_URL=http://seat-service:8086
BOOKING_SERVICE_URL=http://booking-service:8084

# ===== gateway-service =====
JWT_SECRET=
CORS_ALLOWED_ORIGIN=http://localhost:3000
# 라우팅 대상 서비스 호스트(host-only, 포트는 라우트에 고정)
USER_SERVICE_HOST=user-service
AUTH_SERVICE_HOST=auth-service
PERFORMANCE_SERVICE_HOST=performance-service
BOOKING_SERVICE_HOST=booking-service
PAYMENT_SERVICE_HOST=payment-service
SEAT_SERVICE_HOST=seat-service
TICKET_SERVICE_HOST=ticket-service

# ===== auth-service =====
# JWT_SECRET 은 gateway 와 동일 값 재사용. 아래 값들은 미주입 시 부팅에 실패한다.
MAIL_USERNAME=
MAIL_PASSWORD=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
OAUTH_ALLOWED_REDIRECT_DOMAIN=

# ===== performance-service (S3) =====
AWS_S3_BUCKET=
# 부하 테스트 경로는 S3를 타지 않는다. EC2 에 IAM 인스턴스 롤을 붙였다면 아래 둘은 비워둔다.
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=

# ===== ticket-service =====
# QR 서명 시크릿(기본값 없음 — 미주입 시 기동 실패)
TICKET_QR_SECRET=

# ===== 부하 테스트용 토글 =====
# 실 PG 로 결제를 쏘지 않도록 stub 을 켠다. 끄면 booking-create 시나리오가 Toss 로 실결제를 시도한다.
PAYMENT_PG_STUB_ENABLED=true
TOSS_PAYMENTS_ENABLED=false
# 측정 노이즈(주기 배치·Slack 알림)를 제거한다.
DLT_MONITOR_ENABLED=false
SLACK_ENABLED=false
INBOX_RETENTION_ENABLED=false
