# 로컬(local) 프로파일 환경변수 템플릿 — 값은 비워둔다(평문 커밋 금지).
# 사용법: 이 파일을 복사해 .env.local 로 채운 뒤 IntelliJ EnvFile 플러그인 또는
#         `docker compose --env-file .env.local ...` 로 주입한다. .env.local 은 추적 제외다.
#
# [필수] 없으면 해당 서비스가 부팅에 실패한다(기본값 없는 ${VAR}).
# [선택] 기본값이 있어 비워도 뜬다. 실제 연동을 테스트할 때만 채운다.
#
# 서비스 포트: gateway 8080 · user 8081 · auth 8082 · performance 8083
#              booking 8084 · payment 8085 · seat 8086 · ticket 8087

# =========================================================
# 프로파일 / JPA
# =========================================================
# local 단독으로 둔다. dev 는 존재하지 않는 프로파일이고, 조합해서 넣으면
# @Profile("local") 시딩(SeatDataInit·DataInitRunner)이 의도치 않게 섞인다.
SPRING_PROFILES_ACTIVE=local
# 로컬은 update 로 두면 테이블이 자동 생성된다. 스키마(ticket_rush)만 미리 만들어 두면 된다.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# =========================================================
# MySQL — [필수] user·auth·performance·seat·booking·payment·ticket
# =========================================================
# 호스트에 설치된 MySQL 을 쓴다(docker-compose.yml 에 MySQL 은 없다).
# 접속 대상은 jdbc:mysql://localhost:3306/ticket_rush 로 고정이다(application-local.yml).
MYSQL_USERNAME=
MYSQL_PASSWORD=

# =========================================================
# JWT — [필수] gateway·auth
# =========================================================
# HS256 서명 키. 두 서비스가 같은 값을 써야 게이트웨이가 auth 발급 토큰을 검증한다.
JWT_SECRET=

# =========================================================
# 서비스 간 내부 토큰 — [필수] auth·user
# =========================================================
# 나머지 서비스는 기본값(test-token / test-internal-token)이 있어 비워도 뜨지만,
# auth·user 는 기본값이 없어 비면 부팅이 실패한다. 전 서비스가 같은 값을 공유해야 한다.
GATEWAY_INTERNAL_TOKEN=
INTERNAL_API_TOKEN=

# =========================================================
# 메일 (이메일 인증번호 발송) — [필수] auth
# =========================================================
# Gmail 앱 비밀번호 등. 값이 없으면 auth-service 가 뜨지 않는다.
MAIL_USERNAME=
MAIL_PASSWORD=

# =========================================================
# OAuth2 소셜 로그인 — [필수] auth
# =========================================================
# 세 공급자 모두 기본값이 없다. 소셜 로그인을 쓰지 않더라도 auth-service 를 띄우려면
# 형식만 맞는 더미 값이라도 채워야 한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8080/api/v1/auth/naver/callback

# =========================================================
# QR 티켓 서명 — [필수] ticket
# =========================================================
TICKET_QR_SECRET=

# =========================================================
# [선택] 서비스 간 호출 base URL
# =========================================================
# 전부 localhost:포트 기본값이 있다. 서비스를 다른 호스트/포트로 띄울 때만 채운다.
# USER_SERVICE_URL=http://localhost:8081
# AUTH_SERVICE_URL=http://localhost:8082
# PERFORMANCE_SERVICE_URL=http://localhost:8083
# BOOKING_SERVICE_URL=http://localhost:8084
# SEAT_SERVICE_URL=http://localhost:8086
# TICKET_SERVICE_URL=http://localhost:8087

# =========================================================
# [선택] Redis
# =========================================================
# docker compose 의 redis 는 127.0.0.1:6379 로 열려 기본값과 같다.
# REDIS_HOST=localhost
# REDIS_PORT=6379

# =========================================================
# [선택] PG (Toss Payments)
# =========================================================
# ENABLED=false 면 실제 PG 호출 없이 뜬다. 실결제 연동을 테스트할 때만 켠다.
# TOSS_PAYMENTS_ENABLED=false
# TOSS_PAYMENTS_SECRET_KEY=

# =========================================================
# [선택] DLT 모니터링 / Slack 알림
# =========================================================
# 키 이름은 DLT_MONITOR_ENABLED 다(ENABLE 아님 — 오타를 넣으면 조용히 무시된다).
# DLT_MONITOR_ENABLED=false
# SLACK_ENABLED=false
# SLACK_WEBHOOK_URL=

# =========================================================
# [선택] 대기열 (#472 / ADR 0009) — gateway
# =========================================================
# 켜면 POST /api/v1/booking 이 입장 토큰 없는 요청을 403 으로 막는다. 기본은 꺼짐이다.
# QUEUE_ENABLED=false
