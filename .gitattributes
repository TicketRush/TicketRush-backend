#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# adr-tools(bash)가 읽는 파일 — CRLF면 경로/서식이 깨지므로 lf 고정
/.adr-dir       text eol=lf
docs/adr/**     text eol=lf

# EC2로 흘려보내거나 컨테이너에서 실행하는 셸 스크립트. CRLF면 `set -euo pipefail\r`이 되어
# "set: pipefail: invalid option name"으로 첫 줄부터 죽는다. 에러가 bash 버전 문제처럼 보여
# 헤매기 쉽다 — #348에서 샘플러가 두 번(15:18:36Z, 15:19:40Z) 이렇게 실패했다(런북 §10.2).
# 여기 규칙이 없으면 core.autocrlf=true인 Windows 체크아웃에서 매번 재발한다.
*.sh            text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Binary files should be left untouched
*.jar           binary

