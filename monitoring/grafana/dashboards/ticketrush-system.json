{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["ticketrush", "system"],
  "title": "TicketRush - System (MVC)",
  "uid": "ticketrush-system",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(jvm_memory_used_bytes{job=\"ticketrush-services\"}, instance)", "refId": "vars" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "JVM Heap Used",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (instance) (jvm_memory_used_bytes{job=\"ticketrush-services\", area=\"heap\", instance=~\"$instance\"})", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 2,
      "title": "JVM Non-Heap Used",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (instance) (jvm_memory_used_bytes{job=\"ticketrush-services\", area=\"nonheap\", instance=~\"$instance\"})", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 3,
      "title": "GC Pause (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (instance) (rate(jvm_gc_pause_seconds_sum{job=\"ticketrush-services\", instance=~\"$instance\"}[5m]))", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 4,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"ticketrush-services\", instance=~\"$instance\"}[5m]))", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Avg Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (instance) (rate(http_server_requests_seconds_sum{job=\"ticketrush-services\", instance=~\"$instance\"}[5m])) / sum by (instance) (rate(http_server_requests_seconds_count{job=\"ticketrush-services\", instance=~\"$instance\"}[5m]))", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 6,
      "title": "HikariCP Connections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "hikaricp_connections_active{job=\"ticketrush-services\", instance=~\"$instance\"}", "legendFormat": "active {{instance}}" },
        { "refId": "B", "expr": "hikaricp_connections_idle{job=\"ticketrush-services\", instance=~\"$instance\"}", "legendFormat": "idle {{instance}}" },
        { "refId": "C", "expr": "hikaricp_connections_pending{job=\"ticketrush-services\", instance=~\"$instance\"}", "legendFormat": "pending {{instance}}" }
      ]
    },
    {
      "id": 7,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max by (instance, topic) (kafka_consumer_fetch_manager_records_lag{job=\"ticketrush-services\", instance=~\"$instance\"})", "legendFormat": "{{instance}} {{topic}}" }
      ]
    },
    {
      "id": 8,
      "title": "Host CPU Usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node\", mode=\"idle\"}[1m])))", "legendFormat": "cpu used" },
        { "refId": "B", "expr": "100 * avg(rate(node_cpu_seconds_total{job=\"node\", mode=\"iowait\"}[1m]))", "legendFormat": "iowait" }
      ]
    },
    {
      "id": 9,
      "title": "Host Memory",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "node_memory_MemTotal_bytes{job=\"node\"} - node_memory_MemAvailable_bytes{job=\"node\"}", "legendFormat": "used" },
        { "refId": "B", "expr": "node_memory_MemTotal_bytes{job=\"node\"}", "legendFormat": "total" }
      ]
    },
    {
      "id": 10,
      "title": "Host Disk I/O",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(node_disk_read_bytes_total{job=\"node\"}[1m]))", "legendFormat": "read" },
        { "refId": "B", "expr": "sum(rate(node_disk_written_bytes_total{job=\"node\"}[1m]))", "legendFormat": "write" }
      ]
    },
    {
      "id": 11,
      "title": "Outbox Backlog / In-Flight",
      "description": "backlog는 in-flight 행도 세므로 둘을 겹쳐 본다. backlog가 높은데 in-flight가 0이면 릴레이 정지, backlog와 in-flight가 붙어 움직이면 발행은 나갔고 콜백만 늦는 것이다(#483).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "ticketrush_outbox_backlog{job=\"ticketrush-services\", instance=~\"$instance\"}", "legendFormat": "backlog {{instance}}" },
        { "refId": "B", "expr": "ticketrush_outbox_in_flight{job=\"ticketrush-services\", instance=~\"$instance\"}", "legendFormat": "in-flight {{instance}}" }
      ]
    },
    {
      "id": 12,
      "title": "HTTP p95 / p99 (server)",
      "description": "서버가 본 처리시간의 퍼센타일(#495). 네트워크·TLS·커넥션 수립이 빠져 있어 k6 클라이언트 p95와는 다른 축이다 — 앱이 느린지 회선이 느린지 가를 때 이쪽을 본다. 버킷은 slo로 11개만 깔았으므로(1ms~2s) 값은 경계 사이 선형보간이다. 2s를 넘는 응답은 +Inf에만 세어져 p99가 2s에서 포화된 것처럼 보인다.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(http_server_requests_seconds_bucket{job=\"ticketrush-services\", instance=~\"$instance\"}[5m])))", "legendFormat": "p95 {{instance}}" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le, instance) (rate(http_server_requests_seconds_bucket{job=\"ticketrush-services\", instance=~\"$instance\"}[5m])))", "legendFormat": "p99 {{instance}}" }
      ]
    }
  ]
}
