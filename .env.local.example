# 로컬(local) 프로파일 환경변수 템플릿 — 실제 비밀 값은 커밋하지 않는다.
# 사용법: 이 파일을 .env.local로 복사해 채우고, 실행 전에 셸 환경변수로 내보내거나
# IntelliJ EnvFile 플러그인으로 읽는다. Spring Boot는 .env.local을 자동으로 읽지 않는다.
#
# [필수] 해당 서비스를 실행하기 전에 실제 값 또는 로컬 테스트용 값으로 채운다.
# [선택] 사용하지 않으면 주석으로 둔다. KEY=처럼 빈 값을 주입하면 기본값이 적용되지 않을 수 있다.
#
# 서비스 포트: gateway 8080 · user 8081 · auth 8082 · performance 8083
#              booking 8084 · payment 8085 · seat 8086 · ticket 8087

# =========================================================
# 프로파일 / JPA
# =========================================================
# local 단독으로 둔다. dev 는 존재하지 않는 프로파일이고, 조합해서 넣으면
# @Profile("local") 시딩(SeatDataInit·DataInitRunner)이 의도치 않게 섞인다.
SPRING_PROFILES_ACTIVE=local
# 로컬은 update 로 두면 테이블이 자동 생성된다. 스키마(ticket_rush)만 미리 만들어 두면 된다.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# =========================================================
# MySQL — [필수] user·auth·performance·seat·booking·payment·ticket
# =========================================================
# 호스트에 설치된 MySQL 을 쓴다(docker-compose.yml 에 MySQL 은 없다).
# 접속 대상은 jdbc:mysql://localhost:3306/ticket_rush 로 고정이다(application-local.yml).
MYSQL_USERNAME=
MYSQL_PASSWORD=

# =========================================================
# JWT — [필수] gateway·auth
# =========================================================
# HS256 서명 키(32자 이상). 두 서비스가 같은 값을 써야 auth 발급 토큰을 검증한다.
JWT_SECRET=

# =========================================================
# 서비스 간 내부 토큰 — [필수] auth·user
# =========================================================
# 나머지 서비스는 미설정 시 기본값(test-token / test-internal-token)을 쓰지만,
# auth·user 는 기본값이 없다. 각 토큰을 사용하는 서비스 간에 같은 값을 설정해야 한다.
# INTERNAL_API_TOKEN을 빈 값으로 주입하면 기본값이 있는 서비스도 기동에 실패한다.
GATEWAY_INTERNAL_TOKEN=
INTERNAL_API_TOKEN=

# =========================================================
# 메일 (이메일 인증번호 발송) — [필수] auth
# =========================================================
# Gmail 앱 비밀번호 등. 값이 없으면 auth-service 가 뜨지 않는다.
MAIL_USERNAME=
MAIL_PASSWORD=

# =========================================================
# OAuth2 소셜 로그인 — [필수] auth
# =========================================================
# 세 공급자 모두 기본값이 없다. 소셜 로그인을 쓰지 않더라도 auth-service 를 띄우려면
# 형식만 맞는 더미 값이라도 채워야 한다.
# 콜백은 프론트의 /oauth/callback/:provider로 받는다(아래는 localhost:5173 실행 예시).
# 실제로 로그인하려면 각 공급자 콘솔에도 같은 Redirect URI를 등록해야 한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/callback/kakao

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback/google

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:5173/oauth/callback/naver

# =========================================================
# QR 티켓 서명 — [필수] ticket
# =========================================================
# UTF-8 기준 32바이트 이상이어야 한다.
TICKET_QR_SECRET=

# =========================================================
# [선택] 서비스 간 호출 base URL
# =========================================================
# 전부 localhost:포트 기본값이 있다. 서비스를 다른 호스트/포트로 띄울 때만 채운다.
# USER_SERVICE_URL=http://localhost:8081
# AUTH_SERVICE_URL=http://localhost:8082
# PERFORMANCE_SERVICE_URL=http://localhost:8083
# BOOKING_SERVICE_URL=http://localhost:8084
# SEAT_SERVICE_URL=http://localhost:8086
# TICKET_SERVICE_URL=http://localhost:8087

# =========================================================
# [선택] Redis
# =========================================================
# docker compose 의 redis 는 127.0.0.1:6379 로 열려 기본값과 같다.
# REDIS_HOST=localhost
# REDIS_PORT=6379

# =========================================================
# [선택] PG (Toss Payments)
# =========================================================
# 실제 PG 호출 없이 로컬 결제를 테스트하려면 스텁을 켜고 Toss 연동은 끈다.
# PAYMENT_PG_STUB_ENABLED=true
# TOSS_PAYMENTS_ENABLED=false
# Toss 연동을 테스트할 때는 위 두 값을 각각 false/true로 바꾸고 키를 채운다.
# TOSS_PAYMENTS_SECRET_KEY=

# =========================================================
# [선택] DLT 모니터링 / Slack 알림
# =========================================================
# 키 이름은 DLT_MONITOR_ENABLED 다(ENABLE 아님 — 오타를 넣으면 조용히 무시된다).
# DLT_MONITOR_ENABLED=false
# SLACK_ENABLED=false
# SLACK_WEBHOOK_URL=

# =========================================================
# [선택] 대기열 (#472 / ADR 0009) — gateway
# =========================================================
# 켜면 POST /api/v1/booking 이 입장 토큰 없는 요청을 403 으로 막는다. 기본은 꺼짐이다.
# QUEUE_ENABLED=false
# QUEUE_ADMIT_RATE=12
# QUEUE_STATUS_RPS_CAPACITY=400
